[Unit]
Description=Outlook MCP Server
Documentation=https://github.com/bencan1a/cowork-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/outlook-mcp
EnvironmentFile=/home/ubuntu/outlook-mcp/.env
ExecStart=/home/ubuntu/outlook-mcp/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=outlook-mcp

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
