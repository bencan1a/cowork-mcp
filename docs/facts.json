{
  "project_name": "outlook-mcp",
  "description": "Self-hosted Python MCP server providing Claude with read/write access to a personal Outlook account via Microsoft Graph API",
  "python_version": ">=3.11",
  "primary_tools": {
    "package_manager": "pip",
    "testing": "pytest",
    "linting": "ruff",
    "formatting": "ruff",
    "type_checking": "mypy",
    "security": "bandit",
    "mcp_framework": "fastmcp",
    "graph_client": "msgraph-sdk",
    "auth": "msal"
  },
  "folder_structure": {
    "auth/": "OAuth flow and token storage",
    "graph/": "Microsoft Graph API client and domain operations",
    "tests/": "Test files",
    "docs/": "Permanent documentation",
    "docs/_generated/": "Auto-generated documentation",
    "agent-tmp/": "Temporary agent workspace (gitignored)",
    "agent-projects/": "Active agent project folders",
    "deploy/": "systemd unit and Cloudflare Tunnel setup"
  },
  "quality_standards": {
    "test_coverage": ">80%",
    "type_coverage": "100% (all functions must have type annotations)",
    "formatting": "ruff format compliant",
    "linting": "ruff check compliant",
    "security": "bandit compliant"
  },
  "documentation_strategy": {
    "source_of_truth": "docs/",
    "generated_docs": "docs/_generated/",
    "temporary_workspace": "agent-tmp/",
    "main_context": "docs/CONTEXT.md"
  }
}
